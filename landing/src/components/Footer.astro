---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Kolom 1: Branding & Intro -->
      <div class="footer-brand">
        <div class="logo-wrapper">
          <img src="/logo.png" alt="Tahseena Logo" class="footer-logo" />
        </div>
        <p class="brand-desc">Platform edukasi Al-Qur'an modern yang didesain untuk memudahkan setiap muslim dalam memperbaiki bacaan dan hafalan dari mana saja.</p>
      </div>

      <!-- Kolom 2: Tautan Langsung -->
      <div class="footer-links">
        <h3>Akses Cepat</h3>
        <ul>
          <li><a href="#home">Beranda</a></li>
          <li><a href="#program">Program Kelas</a></li>
          <li><a href="#tentang">Tentang Kami</a></li>
          <li><a href="#testimoni">Kisah Sahabat</a></li>
          <li><a href="#faq">Pusat Bantuan</a></li>
        </ul>
      </div>

      <!-- Kolom 3: Kontak -->
      <div class="footer-contact">
        <h3>Hubungi Kami</h3>
        <ul>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            +62 812-3456-7890
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            salam@tahseena.com
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            Jakarta Selatan, Indonesia
          </li>
        </ul>
      </div>

      <!-- Kolom 4: Media Sosial -->
      <div class="footer-social">
        <h3>Ikuti Perjalanan Kami</h3>
        <p>Dapatkan tips tajwid dan info promo terbaru di sosial media kami.</p>
        <div class="social-icons">
          <a href="#" aria-label="Instagram">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="#" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33 2.78 2.78 0 0 0 1.94 2c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
          </a>
          <a href="#" aria-label="Facebook">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Garis Pemisah & Copyright -->
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Tahseena Quran Academy. Hak Cipta Dilindungi.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: transparent;
    color: var(--text-main);
    padding: 100px 0 30px 0;
    font-family: var(--font-main);
    border-top: 1px solid var(--card-border);
    transition: background 0.3s;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.5fr 1.5fr;
    gap: 50px;
    margin-bottom: 60px;
  }

  .logo-wrapper {
    background: var(--card-bg);
    padding: 15px 25px;
    border-radius: 15px;
    display: inline-block;
    margin-bottom: 25px;
    border: 1px solid var(--card-border);
    backdrop-filter: blur(10px);
  }

  .footer-logo {
    height: 40px;
    width: auto;
    display: block;
    transition: 0.3s;
  }

  :global([data-theme='dark']) .footer-logo {
    filter: invert(1) hue-rotate(180deg) brightness(1.2);
  }

  .brand-desc {
    color: var(--text-light);
    line-height: 1.8;
    font-size: 1.05rem;
    padding-right: 20px;
  }

  .footer h3 {
    color: var(--text-main);
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 25px 0;
    position: relative;
    padding-bottom: 12px;
  }

  .footer h3::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 40px;
    height: 3px;
    background: var(--primary-cyan);
    border-radius: 2px;
  }

  .footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: 15px;
  }

  .footer-links a {
    color: var(--text-light);
    text-decoration: none;
    transition: all 0.3s ease;
    font-size: 1.05rem;
  }

  .footer-links a:hover {
    color: var(--primary-cyan);
    padding-left: 5px;
  }

  .footer-contact li {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    margin-bottom: 20px;
    color: var(--text-light);
    line-height: 1.6;
  }

  .footer-contact svg {
    width: 22px;
    height: 22px;
    color: var(--primary-cyan);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .footer-social p {
    color: var(--text-light);
    line-height: 1.6;
    margin-bottom: 25px;
  }

  .social-icons {
    display: flex;
    gap: 15px;
  }

  .social-icons a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 45px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 50%;
    color: var(--text-main);
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
  }

  .social-icons a:hover {
    background: var(--primary-blue);
    color: white;
    border-color: var(--primary-blue);
    transform: translateY(-3px);
  }

  .social-icons svg {
    width: 20px;
    height: 20px;
  }

  .footer-bottom {
    border-top: 1px solid var(--card-border);
    padding-top: 30px;
    text-align: center;
    color: var(--text-light);
    font-size: 0.95rem;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 768px) {
    .footer { padding-top: 60px; }
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }
    .footer h3::after {
      left: 50%;
      transform: translateX(-50%);
    }
    .brand-desc {
      padding-right: 0;
      max-width: 450px;
      margin: 0 auto;
    }
    .footer-contact li {
      justify-content: center;
    }
    .social-icons {
      justify-content: center;
    }
  }
</style>
