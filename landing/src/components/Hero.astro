---
---
<section class="hero">
  <!-- Subtle Background Pattern -->
  <div class="pattern-overlay"></div>
  
  <div class="container hero-container">
    <div class="hero-content">
      <div class="badge fade-up">
        <span class="dot"></span>
        Belajar Quran itu Mudah
      </div>
      
      <h1 class="fade-up arabic" style="animation-delay: 0.1s; direction: rtl;">
        وَلَقَدۡ يَسَّرۡنَا ٱلۡقُرۡءَانَ لِلذِّكۡرِ <br/> 
        <span class="text-gradient">فَهَلۡ مِن مُّدَّكِرٖ</span> ١٧
      </h1>
      
      <p class="fade-up" style="animation-delay: 0.2s;">
        "Dan sesungguhnya telah Kami mudahkan Al-Qur'an untuk pelajaran, <br/> 
        maka adakah orang yang mengambil pelajaran?" <br/>
        <span class="footnote">&mdash; Q.S. Al-Qamar: 17</span>
      </p>
      
      <div class="cta-group fade-up" style="animation-delay: 0.3s;">
        <a href="#daftar" class="btn-primary">Mulai Belajar Sekarang</a>
        <a href="#video" class="btn-outline">
          <span class="play-icon">▶</span>
          Lihat Video Profil
        </a>
      </div>
    </div>

    <div class="hero-visual fade-up" style="animation-delay: 0.2s;">
      <div class="visual-wrapper">
        <!-- Card 1: Offline & Online -->
        <div class="floating-card c1">
          <div class="icon">🏠</div>
          <div class="text">
            <strong>Offline & Online</strong>
            <span>Belajar Lebih Fleksibel</span>
          </div>
        </div>
        
        <div class="main-visual">
          <div class="visual-placeholder">
            <div class="logo-glow"></div>
            <img src="/logo.png" alt="Tahseena Logo" class="floating-logo" />
          </div>
        </div>

        <!-- Card 2: Metode Talaqqi -->
        <div class="floating-card c2">
          <div class="icon">👤</div>
          <div class="text">
            <strong>Metode Talaqqi</strong>
            <span>Bimbingan Langsung & Privat</span>
          </div>
        </div>
      </div>

      <!-- Statistik diletakkan Di Bawah seluruh paket kartu -->
      <div class="stats hero-stats-refined">
        <div class="stat-item">
          <strong>1.2k+</strong>
          <span>Santri Aktif</span>
        </div>
        <div class="divider"></div>
        <div class="stat-item">
          <strong>50+</strong>
          <span>Ustadz Ahli</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 140px; /* Dikurangi sedikit agar lebih seimbang */
    background: var(--bg-gradient);
    overflow: hidden;
  }

  .pattern-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: url('https://www.transparenttextures.com/patterns/islamic-art.png');
    opacity: 0.03;
    z-index: 1;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 60px;
    align-items: flex-start; /* Ubah ke flex-start agar sejajar dari atas */
    position: relative;
    z-index: 2;
  }

  .hero-visual {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .hero-stats-refined {
    position: absolute;
    top: 385px; /* Digeser dikit lagi ke bawah sesuai permintaan */
    left: 40px;
    z-index: 10;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    backdrop-filter: blur(10px);
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--primary-teal);
    margin-bottom: 24px;
    box-shadow: var(--shadow-soft);
    transition: 0.3s;
  }

  .dot {
    width: 8px;
    height: 8px;
    background: var(--primary-cyan);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--primary-cyan);
  }

  h1 {
    font-size: 3.3rem;
    line-height: 1.15;
    color: var(--text-main);
    margin-bottom: 24px;
  }

  h1.arabic {
    font-size: 3.8rem;
    font-weight: 400; /* Dibuat tidak tebal agar lebih elegan */
    line-height: 1.7;
    margin-bottom: 15px;
    text-shadow: 0 4px 25px rgba(20, 145, 124, 0.3); /* Dibuat lebih tebal & pendarannya lebih luas */
  }

  .text-gradient {
    background: linear-gradient(90deg, var(--primary-teal), var(--primary-blue));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  p {
    font-size: 1.1rem;
    color: var(--text-light);
    max-width: 550px;
    margin-bottom: 25px; /* Dikurangi agar tombol lebih naik */
  }

  .footnote {
    font-size: 0.85rem;
    opacity: 0.7;
    font-style: italic;
    margin-top: 5px;
    display: inline-block;
  }

  .cta-group {
    display: flex;
    gap: 20px;
    margin-bottom: 50px;
  }

  .btn-primary {
    padding: 16px 32px;
    background: linear-gradient(135deg, var(--primary-teal), var(--primary-blue));
    color: white;
    border-radius: 14px;
    font-weight: 700;
    text-decoration: none; /* Hapus garis bawah */
    box-shadow: 0 10px 25px rgba(20, 145, 124, 0.2);
    transition: 0.3s;
  }

  .btn-outline {
    padding: 16px 32px;
    border: 1px solid var(--primary-blue);
    color: var(--text-main);
    border-radius: 14px;
    font-weight: 600;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: 0.3s;
  }

  :global([data-theme='dark']) .btn-outline {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.05);
  }

  .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(20, 145, 124, 0.3); }
  .btn-outline:hover { background: rgba(0,0,0,0.02); transform: translateY(-3px); }

  .play-icon {
    font-size: 0.8rem;
    width: 24px;
    height: 24px;
    background: var(--primary-cyan);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .stats {
    display: flex;
    gap: 32px;
    align-items: center;
  }

  .stat-item strong {
    display: block;
    font-size: 1.5rem;
    color: var(--text-main);
  }

  .stat-item span {
    font-size: 0.9rem;
    color: var(--text-light);
  }

  .divider {
    width: 1px;
    height: 40px;
    background: rgba(0,0,0,0.1);
  }

  /* Visual Elements */
  .visual-wrapper {
    position: relative;
    padding: 40px;
  }

  .main-visual {
    width: 100%;
    aspect-ratio: 1/1;
    background: radial-gradient(circle at center, rgba(255,255,255,0.05) 0%, var(--card-bg) 70%);
    border-radius: 40px;
    box-shadow: var(--shadow-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--card-border);
    backdrop-filter: blur(20px);
    transition: background 0.3s;
  }

  .logo-glow {
    position: absolute;
    width: 200px;
    height: 200px;
    background: var(--primary-cyan);
    filter: blur(80px);
    opacity: 0.3;
    animation: pulse 4s infinite;
  }

  .floating-logo {
    width: 180px;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.1));
    animation: float 6s ease-in-out infinite;
    transition: filter 0.3s;
  }

  :global([data-theme='dark']) .floating-logo {
    filter: invert(1) hue-rotate(180deg) brightness(1.2);
  }

  .floating-card {
    position: absolute;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    backdrop-filter: blur(10px);
    padding: 16px 20px;
    border-radius: 20px;
    box-shadow: var(--shadow-soft);
    display: flex;
    gap: 12px;
    align-items: center;
    z-index: 10;
    transition: 0.3s;
  }

  .floating-card:hover { transform: scale(1.05) translateY(-5px); }

  .c1 { top: 0%; left: -10%; } /* Satu Paket: nempel di sudut logo */
  .c2 { bottom: 0%; right: -10%; }

  .floating-card .icon {
    width: 40px;
    height: 40px;
    background: #f0fdfa;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    font-size: 1.2rem;
  }

  .floating-card strong { display: block; font-size: 0.9rem; color: var(--text-main); }
  .floating-card span { font-size: 0.75rem; color: var(--text-light); }

  /* Animations */
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.2; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.2); }
  }

  .fade-up {
    opacity: 0;
    animation: fadeUp 1s ease-out forwards;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Responsive Tablet & Mobile Refinement */
  @media (max-width: 1024px) {
    .hero {
      padding-top: 130px;
      padding-bottom: 80px;
      min-height: auto;
    }
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 50px;
    }
    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    p {
      text-align: center;
    }
    .hero-visual {
      max-width: 450px;
      margin: 0 auto;
      align-items: center;
    }
    .hero-stats-refined {
      position: relative;
      top: 0;
      left: 0;
      margin-top: 40px;
      justify-content: center;
    }
    .c1 { top: -10px; left: 0px; }
    .c2 { bottom: -10px; right: 0px; }
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: 110px;
      padding-bottom: 60px;
    }
    .hero-container {
      gap: 40px;
    }
    .badge {
      font-size: 0.75rem;
      margin-bottom: 16px;
    }
    h1.arabic {
      font-size: 2.2rem;
      line-height: 1.6;
      margin-bottom: 12px;
    }
    p {
      font-size: 0.95rem;
      margin-bottom: 25px;
      padding: 0 5%;
    }
    .cta-group {
      width: 100%;
      flex-direction: column;
      gap: 12px;
    }
    .btn-primary, .btn-outline {
      width: 100%;
      padding: 15px;
      justify-content: center;
    }
    .main-visual {
      width: 250px;
      height: 250px;
      border-radius: 30px;
    }
    .floating-logo {
      width: 120px;
    }
    .c1 { top: -15px; left: -10px; }
    .c2 { bottom: -15px; right: -10px; }
    
    .floating-card {
      padding: 10px 14px;
      gap: 8px;
    }
    .floating-card .icon {
      width: 30px; height: 30px; font-size: 1rem; border-radius: 10px;
    }
    .floating-card strong { font-size: 0.8rem; }
    .floating-card span { font-size: 0.65rem; }
    
    .hero-stats-refined {
      gap: 20px;
      margin-top: 30px;
    }
    .stat-item strong {
      font-size: 1.2rem;
    }
  }
</style>
