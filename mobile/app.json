{
  "expo": {
    "name": "I-QLab",
    "slug": "iqlab-mobile",
    "scheme": "iqlab",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/adaptive-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iqlab.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "I-QLab membutuhkan izin Speech Recognition untuk mengubah suara Bos menjadi teks.",
        "NSMicrophoneUsageDescription": "I-QLab membutuhkan akses microphone untuk mendengar perintah suara Bos."
      }
    },
    "plugins": [
      "react-native-video",
      "./withAndroidNativeBuildFixes",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "includeCompileSdkVersionInResources": true
          }
        }
      ],
      "expo-asset",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "I-QLab membutuhkan akses microphone untuk mendengar perintah suara Bos.",
          "speechRecognitionPermission": "I-QLab membutuhkan izin Speech Recognition untuk mengubah suara Bos menjadi teks."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1e3a8a",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "I-QLab"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e3a8a"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.iqlab.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_WIFI_STATE",
        "ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ]
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#1e3a8a",
      "translucent": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6e32387f-eeeb-47f4-8134-60f1de798b3d"
      }
    },
    "owner": "didimdim"
  }
}
